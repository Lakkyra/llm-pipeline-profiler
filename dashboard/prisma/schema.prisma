datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Run {
  id                  String           @id @default(uuid())
  name                String
  created_at          DateTime         @default(now())
  model_name          String?
  hardware_info       Json?            // Stores GPU type, VRAM, and CPU count
  peak_tflops         Float?           // Empirical/calibrated peak compute ceiling
  peak_bandwidth_gb_s Float?           // Empirical/calibrated peak memory bandwidth ceiling
  ridge_point         Float?           // Knee point in FLOPs/Byte
  device_name         String?          // Target GPU architecture string
  stages              Stage[]
  operators           OperatorMetric[]
}

model Stage {
  id               String           @id @default(uuid())
  run_id           String
  run              Run              @relation(fields: [run_id], references: [id], onDelete: Cascade)
  name             String
  start_time       DateTime
  end_time         DateTime
  duration_ms      Float
  cpu_percent      Float
  ram_used_mb      Float
  gpu_util_percent Float
  gpu_mem_used_mb  Float
  trace_ref        String?
  metrics          Metric[]
  operators        OperatorMetric[]

  @@index([run_id])
}

model Metric {
  id        String   @id @default(uuid())
  stage_id  String
  stage     Stage    @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  timestamp DateTime
  key       String
  value     Float

  @@index([stage_id, timestamp])
}

model OperatorMetric {
  id                     String   @id @default(uuid())
  run_id                 String
  run                    Run      @relation(fields: [run_id], references: [id], onDelete: Cascade)
  stage_id               String?
  stage                  Stage?   @relation(fields: [stage_id], references: [id], onDelete: SetNull)
  op_name                String
  category               String   // "compute_dense", "attention", "norm", "elementwise"
  duration_ms            Float
  flops                  Float
  bytes_transferred      Float
  operational_intensity  Float    // FLOPs/Byte (I)
  achieved_tflops        Float    // Achieved TFLOPS
  achieved_bandwidth_gb_s Float   // Achieved GB/s
  bound_classification   String   // "memory_bound", "compute_bound", "latency_limited"
  recommendation         String
  metadata               Json?
  created_at             DateTime @default(now())

  @@index([run_id])
  @@index([stage_id])
}
